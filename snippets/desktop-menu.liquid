<desktop-navigation>
  <ul class="header__linklist list--unstyled {% unless bottom_navigation %}hidden-pocket hidden-lap{% endunless %}" role="list">
    {%- for link in menu.links -%}
      {%- assign link_title_downcase = link.title | strip | downcase -%}
      {%- assign mega_menu_block = '' -%}
      {%- assign mega_menu_images = '' -%}
      {%- assign images_count = 0 -%}
      {%- assign nav_cta_class = '' -%}

      {%- if link_title_downcase == 'new arrivals' -%}
        {%- assign nav_cta_class = 'header__linklist-item--cta header__linklist-item--cta-new' -%}
      {%- elsif link_title_downcase == 'best sellers' -%}
        {%- assign nav_cta_class = 'header__linklist-item--cta header__linklist-item--cta-best' -%}
      {%- elsif link_title_downcase == 'sale' -%}
        {%- assign nav_cta_class = 'header__linklist-item--cta header__linklist-item--cta-sale' -%}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- assign menu_item_downcase = block.settings.menu_item | strip | downcase -%}

        {%- if menu_item_downcase == link_title_downcase -%}
          {%- assign mega_menu_block = block -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if mega_menu_block != '' -%}
        {%- capture mega_menu_images -%}
          {%- for i in (1..6) -%}
            {%- capture image_setting -%}image_{{ i }}{%- endcapture -%}

            {%- if mega_menu_block.settings[image_setting] != blank -%}
              {%- assign images_count = images_count | plus: 1 -%}

              {%- capture image_heading_setting -%}image_{{ i }}_heading{%- endcapture -%}
              {%- capture image_text_setting -%}image_{{ i }}_text{%- endcapture -%}
              {%- capture image_link_setting -%}image_{{ i }}_link{%- endcapture -%}

              {%- capture image_push -%}
                <div class="mega-menu__image-wrapper">
                  {%- assign menu_image = mega_menu_block.settings[image_setting] -%}
                  {{ menu_image | image_url: width: menu_image.width | image_tag: loading: 'lazy', sizes: '240px', sizes: '240,480,720', class: 'mega-menu__image' }}
                </div>

                {%- if mega_menu_block.settings[image_heading_setting] != '' -%}
                  <p class="mega-menu__heading heading heading--small">{{ mega_menu_block.settings[image_heading_setting] }}</p>
                {%- endif -%}

                {%- if mega_menu_block.settings[image_text_setting] != '' -%}
                  <span class="mega-menu__text">{{ mega_menu_block.settings[image_text_setting] }}</span>
                {%- endif -%}
              {%- endcapture -%}

              {%- if mega_menu_block.settings[image_link_setting] != blank -%}
                <a href="{{ mega_menu_block.settings[image_link_setting] }}" class="mega-menu__image-push image-zoom">
                  {{- image_push -}}
                </a>
              {%- else -%}
                <div class="mega-menu__image-push image-zoom">
                  {{- image_push -}}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
      {%- endif -%}

      <li class="header__linklist-item {% if link.links.size > 0 or mega_menu_images != blank %}has-dropdown{% endif %} {{ nav_cta_class }}" data-item-title="{{ link.title | escape }}">
        <a class="header__linklist-link {% if link.links.size > 0 or mega_menu_images != blank %}header__linklist-link--dropdown{% endif %}" href="{{ link.url }}" {% if link.links.size > 0 or mega_menu_images != blank %}aria-controls="desktop-menu-{{ forloop.index }}" aria-expanded="false"{% endif %}>
          <span class="header__linklist-label">{{- link.title -}}</span>

          {%- if link.links.size > 0 -%}
            <span class="nv_cstmIcon" aria-hidden="true">
              {% render 'icon' with 'nav_icon' %}
            </span>
          {%- endif -%}
        </a>

        {%- comment -%}
          Always use mega-menu panel for items with children (not the simple nav-dropdown),
          so new menu titles still get the wide layout. Product cards come from matching blocks.
        {%- endcomment -%}
        {%- if link.links.size > 0 or mega_menu_images != blank -%}
          <div hidden id="desktop-menu-{{ forloop.index }}" class="mega-menu" {% if mega_menu_block != '' %}{{ mega_menu_block.shopify_attributes }}{% endif %}>
            <div class="container">
              <div class="mega-menu__inner">
                {%- if mega_menu_block != '' and mega_menu_block.settings.images_position == 'left' and mega_menu_images != blank -%}
                  <div class="mega-menu__images-wrapper {% if images_count >= 3 %}mega-menu__images-wrapper--tight{% endif %}">
                    {{- mega_menu_images -}}
                  </div>
                {%- endif -%}

                {%- if link.links.size > 0 -%}
                  <div class="mega-menu__columns-wrapper">
                    {%- for sub_link in link.links -%}
                      <div class="mega-menu__column">
                        {%- if sub_link.url == blank or sub_link.url == '#' -%}
                          <span class="mega-menu__title heading heading--small">{{ sub_link.title }}</span>
                        {%- else -%}
                          <a href="{{ sub_link.url }}" class="mega-menu__title heading heading--small">{{ sub_link.title }}</a>
                        {%- endif -%}

                        {%- if sub_link.links.size > 0 -%}
                          <ul class="linklist list--unstyled" role="list">
                            {%- for sub_sub_link in sub_link.links -%}
                              <li class="linklist__item">
                                <a href="{{ sub_sub_link.url }}" class="link--faded">{{ sub_sub_link.title }}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if mega_menu_block != '' and mega_menu_block.settings.images_position != 'left' and mega_menu_images != blank -%}
                  <div class="mega-menu__images-wrapper {% if images_count >= 3 %}mega-menu__images-wrapper--tight{% endif %}">
                    {{- mega_menu_images -}}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      </li>
    {%- endfor -%}

    <li class="header__linklist-item header__linklist-item--more has-dropdown" data-nav-more hidden>
      <button type="button" class="header__linklist-link header__linklist-link--dropdown" aria-expanded="false" aria-controls="desktop-menu-more" data-nav-more-trigger>
        <span class="header__linklist-label">More</span>
        <span class="nv_cstmIcon" aria-hidden="true">
          {% render 'icon' with 'nav_icon' %}
        </span>
      </button>
      <ul hidden id="desktop-menu-more" class="nav-dropdown nav-dropdown--more list--unstyled" role="list" data-nav-more-list></ul>
    </li>
  </ul>
</desktop-navigation>
